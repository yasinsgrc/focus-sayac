<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <!-- Ekran 05'in "Kaydet"i (`gal`). Android 10'dan (API 29) itibaren
         MediaStore izin istemiyor, bu yüzden izin yalnızca eski sürümlerde
         geçerli; minSdk 23 olduğu için gerekiyor. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <application
        android:label="FocusSayaç"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google'ın resmî test App ID'si. Gerçek AdMob App ID yayından önce
             buraya girilir; AdMob hesabı açılana kadar test kimliği kalıyor
             ("kendi reklamına tıklama" trafiği üretmemek için). Reklam
             BİRİMİ kimlikleri koda gömülü değil, `dart-define` bayrağıyla
             geliyor
             (`lib/services/ads/ad_unit_ids.dart`); App ID manifest'te olmak
             zorunda olduğu için tek elle değişen değer bu satır.
             Yayın adımları: docs/play/RELEASE.md -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Ana ekran widgetlari (Faz 16). Bes saglayici da
             BaseFocusWidgetProvider uzerinden ayni anlik goruntuyu okur;
             cizim ve zaman hesabi Kotlin tarafinda yapilir.
             Bkz. docs/superpowers/specs/2026-09-04-home-widgets-design.md -->
        <receiver
            android:name=".widget.RingWidgetProvider"
            android:exported="false"
            android:label="@string/widget_ring_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ring_info" />
        </receiver>
        <receiver
            android:name=".widget.StripWidgetProvider"
            android:exported="false"
            android:label="@string/widget_strip_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_strip_info" />
        </receiver>
        <receiver
            android:name=".widget.StreakWidgetProvider"
            android:exported="false"
            android:label="@string/widget_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>
        <receiver
            android:name=".widget.QuickFocusWidgetProvider"
            android:exported="false"
            android:label="@string/widget_quick_focus_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_focus_info" />
        </receiver>
        <receiver
            android:name=".widget.PanoramaWidgetProvider"
            android:exported="false"
            android:label="@string/widget_panorama_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_panorama_info" />
        </receiver>

        <!-- Widget tazeleme: saat basi alarm + sistemin zaman/saat dilimi
             olaylari. Zaman elle degistiginde ya da yurt disina gecildiginde
             kalan gun aninda degisir; bir sonraki saati beklemek gorunur bir
             yanlislik olurdu. -->
        <receiver
            android:name=".widget.FocusWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focussayac.focussayac.widget.ACTION_REFRESH" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
