<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget kart zemini - prototipin `-surface-card` (#D11E2030) dolgusu ve
  `-divider` (#14FFFFFF) hairline kenari. Kose yaricapi uygulamanin kart
  yaricapiyla ayni (24dp).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/focus_surface_card" />
    <stroke
        android:width="1dp"
        android:color="@color/focus_divider" />
    <corners android:radius="24dp" />
</shape>
