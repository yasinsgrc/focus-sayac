<?xml version="1.0" encoding="utf-8"?>
<!--
  Serit widget (4x1). Ust satirda sinav adi ve kalan sure, altta ince
  doluluk cubugu (StripRenderer bitmap).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_compact"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_strip_exam"
            android:text="@string/widget_pick_exam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter_600"
            android:maxLines="1"
            android:textColor="@color/focus_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_strip_value"
            android:text="@string/widget_days_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/space_grotesk_700"
            android:maxLines="1"
            android:textColor="@color/focus_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_strip_bar"
        android:src="@drawable/widget_preview_bar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/widget_strip_label"
        android:scaleType="fitXY" />
</LinearLayout>
