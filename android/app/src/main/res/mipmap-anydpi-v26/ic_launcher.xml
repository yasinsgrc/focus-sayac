<?xml version="1.0" encoding="utf-8"?>
<!--
  Gorsel Kimlik 02 · ADAPTIVE: "108x108 dp katmanlar, isaret 72 dp guvenli
  alanda - sistem hangi maskeyi uygularsa uygulasin halka kesilmiyor."

  `monochrome` (Gorsel Kimlik 03) Android 13+ temali simgeler icin; sistem
  duvar kagidindan renk cekip tek renk siluete uyguluyor. Eski surumler bu
  satiri yok sayar, API 26-32'de foreground + background kullanilir.

  Katman PNG'leri `tool/generate_app_icon.py` uretiyor.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
