<?xml version="1.0" encoding="utf-8"?>
<!--
  Gorsel Kimlik 02 · ADAPTIVE: "108x108 dp katmanlar, isaret 66 dp keyline
  dairesinde - sistem hangi maskeyi uygularsa uygulasin halka kesilmiyor."

  Isaret onceden 72 dp cizilmisti; gorunen alan da 72 dp oldugu icin maske
  halkaya tam tegetti ve One UI'da (Galaxy S24) ust/alt/sag/sol dort ana yonde
  sac teli kadar kirpiyordu. Material keyline'i (192 dp tuvalde 176 dp daire)
  72 dp'ye 66 dp olarak dusuyor; her kenarda 3 dp pay birakiyor.

  `monochrome` (Gorsel Kimlik 03) Android 13+ temali simgeler icin; sistem
  duvar kagidindan renk cekip tek renk siluete uyguluyor. Eski surumler bu
  satiri yok sayar, API 26-32'de foreground + background kullanilir.

  Katman PNG'leri `tool/generate_app_icon.py` uretiyor.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
