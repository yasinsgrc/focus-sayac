<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis 0: sistemin garantisiz 30 dakikalik dongusu yerine
  RefreshScheduler saat basina hizalanmis kendi alarmini kuruyor.
  previewLayout (API 31+) gercek yerlesimi onizleme olarak gosteriyor,
  ayri bir statik PNG bakimi gerekmiyor.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_strip_description"
    android:initialLayout="@layout/widget_strip"
    android:minHeight="40dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_strip"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
